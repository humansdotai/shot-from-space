{
  "name": "shotfromspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run env:setup && npm run db:setup && next dev --turbopack",
    "build": "npm run env:setup && npm run db:provider && prisma generate && NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:integration": "playwright test --project=integration",
    "test:e2e": "playwright test --project=e2e",
    "postinstall": "npm run env:setup && npm run db:provider && prisma generate",
    "db:provider": "node scripts/select-db-provider.mjs",
    "db:push": "npm run db:provider && prisma db push --skip-generate",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:setup": "npm run env:setup && npm run db:push && npm run db:seed",
    "db:reset": "rm -f prisma/dev.db && npm run db:setup",
    "db:studio": "prisma studio",
    "env:setup": "node -e \"const fs=require('fs');if(!process.env.DATABASE_URL && !fs.existsSync('.env')){fs.copyFileSync('.env.example','.env');console.log('created .env from .env.example')}\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "next": "15.5.23",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "satellite.js": "6.0.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
