# ── Stripe ─────────────────────────────────────────────────────────────
# Live or test keys from your Stripe dashboard.
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# Optional: only needed if you wire the /api/webhook endpoint in Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ────────────────────────────────────────────────────────────────
# Absolute origin used to build Stripe success/cancel URLs.
# On Vercel this is auto-derived from VERCEL_URL if left blank.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Imagery partners (all optional) ────────────────────────────────────
# When a partner key is present the matching adapter places a REAL tasking
# order; otherwise that partner runs in high-fidelity SIMULATION mode.
SKYFI_API_KEY=
SKYWATCH_API_KEY=
