# ==================================================================
# SHOT FROM SPACE — environment
#
# A fresh clone needs NONE of these. `npm install && npm run dev` runs the
# whole product in mock mode with realistic fake data.
# Read INTEGRATIONS.md before flipping anything to live.
# ==================================================================

# --- Core ---------------------------------------------------------
# Master switch. true = every external service is mocked. Default: true.
MOCK_MODE=true
# Client-visible mirror of the above. Drives the footer MOCK MODE indicator.
NEXT_PUBLIC_MOCK_MODE=true
# Absolute site URL. Used in emails, magic links and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -----------------------------------------------------
# SQLite file, created by `npm run db:setup`. No server required.
DATABASE_URL="file:./dev.db"

# --- Stripe (payments) --------------------------------------------
# dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# dashboard.stripe.com/webhooks → endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- SkyFi (satellite tasking) ------------------------------------
# app.skyfi.com → Account → API
SKYFI_API_KEY=
SKYFI_API_BASE_URL=https://app.skyfi.com/platform-api
# Shared secret for /api/webhooks/skyfi
SKYFI_WEBHOOK_SECRET=

# --- Gelato (print + fulfilment) ----------------------------------
# dashboard.gelato.com → Developers → API keys
GELATO_API_KEY=
GELATO_API_BASE_URL=https://order.gelatoapis.com
# dashboard.gelato.com → Developers → Webhooks → /api/webhooks/gelato
GELATO_WEBHOOK_SECRET=

# --- Mission Control operator (LLM) -------------------------------
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
MISSION_CONTROL_MODEL=claude-sonnet-4-20250514

# --- ElevenLabs (voice link) --------------------------------------
# elevenlabs.io → Profile → API key
ELEVENLABS_API_KEY=
# elevenlabs.io → Conversational AI → your agent → Agent ID
ELEVENLABS_AGENT_ID=

# --- Email (transactional) ----------------------------------------
# resend.com → API keys
RESEND_API_KEY=
EMAIL_FROM="Mission Control <mission@shotfromspace.com>"

# --- Geocoding (address autocomplete) -----------------------------
# account.mapbox.com → Access tokens.
#
# ALSO UPGRADES THE CAPTURE-FRAMING BASEMAP. The framing tool on the
# purchase flow works with no key at all: it serves Sentinel-2
# "s2cloudless" from EOX, which is free, keyless and CC BY 4.0, so a
# fresh clone frames a real capture out of the box. Sentinel-2 is 10 m
# and its pyramid stops at zoom 17, which is genuinely enough to place a
# 1-4 km footprint but not enough to see a roof.
#
# Setting this (z22, 0.30 m) or MAPTILER_KEY (z20, 0.50 m) swaps the
# basemap server-side in lib/tiles.ts. The browser component never
# changes: it only ever asks /api/tiles/{z}/{x}/{y} and credits whatever
# /api/tiles/meta names, so the attribution can never drift away from
# whoever actually served the pixels.
#
# NOT Esri World Imagery. Its tiles are reachable without a key, which
# makes it a tempting default, but Esri's terms restrict the service to
# ArcGIS licence holders and exclude commercial use.
MAPBOX_ACCESS_TOKEN=
# cloud.maptiler.com → Keys. Alternative to the above; either one is enough.
MAPTILER_KEY=

# --- Scheduled jobs ------------------------------------------------
# Bearer token for POST/GET /api/jobs/refund-sweep, which keeps the
# sixty-day refund guarantee in /legal/terms. WITHOUT THIS THE JOB
# REFUSES TO RUN and the guarantee is not being kept automatically.
# Any long random string; on Vercel, pair it with a daily cron entry:
#   { "crons": [{ "path": "/api/jobs/refund-sweep", "schedule": "0 3 * * *" }] }
CRON_SECRET=

# --- Eyepup (product analytics) -----------------------------------
# eyepup.com → Sites. Same value as the browser snippet URL token; it is the
# PUBLIC project token, used server-side to identify users and record the
# purchase conversion (lib/integrations/eyepup.ts). Not a secret.
EYEPUP_PROJECT_TOKEN=

# ---- Admin -------------------------------------------------------
# Opens /admin (orders board, print approval, refunds). ≥12 chars. Unset = closed.
ADMIN_SECRET=
